---
import AskBar from '../components/AskBar.astro';
import Chapter from '../components/Chapter.astro';
import Intro from '../components/Intro.astro';
import ReadingMeter from '../components/ReadingMeter.astro';
import Stage from '../components/Stage.astro';
import Topbar from '../components/Topbar.astro';
import Base from '../layouts/Base.astro';
import { person } from '../data/cv';
import { chapters } from '../data/story';

const suggestions = [
  'Have you shipped RAG to production?',
  'Which agent frameworks do you use?',
  'Can you deploy on AWS?',
  'When can you start?',
];
---

<Base
  title={`${person.name}, AI Engineer`}
  description="Muhammad Uzair builds language-model agents for real products. Five years in data science and machine learning, most recently AI Engineer on Aida at Money Means. Available now."
>
  <Stage />
  <Topbar />
  <main class="story">
    <Intro />
    {chapters.map((chapter) => <Chapter chapter={chapter} />)}
  </main>
  <ReadingMeter />
  <AskBar suggestions={suggestions} />
</Base>

<script>
  import '../scripts/main';
</script>

<style>
  .story {
    position: relative;
    z-index: 1;
  }
</style>
