---
import AskBar from '../components/AskBar.astro';
import Chapter from '../components/Chapter.astro';
import Intro from '../components/Intro.astro';
import ReadingMeter from '../components/ReadingMeter.astro';
import Stage from '../components/Stage.astro';
import Topbar from '../components/Topbar.astro';
import Base from '../layouts/Base.astro';
import { askSuggestions, meta } from '../data/copy';
import { chapters } from '../data/story';
---

<Base title={meta.title} description={meta.description}>
  <Stage />
  <Topbar />
  <main class="story">
    <Intro />
    {chapters.map((chapter) => <Chapter chapter={chapter} />)}
  </main>
  <ReadingMeter />
  <AskBar suggestions={askSuggestions} />
</Base>

<script>
  import '../scripts/main';
</script>

<style>
  .story {
    position: relative;
    z-index: 1;
  }
</style>
