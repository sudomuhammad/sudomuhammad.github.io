---
import Base from '../layouts/Base.astro';
import { clusters, roles, education, person } from '../data/cv';

const colorOf = Object.fromEntries(clusters.map((c) => [c.id, c.color]));
const nameOf = Object.fromEntries(clusters.map((c) => [c.id, c.name]));
---

<Base
  title={`${person.name}, AI Engineer`}
  description="Muhammad Uzair builds language-model agents for real products. Five years in data science and machine learning, currently AI Engineer on Aida at Money Means."
>
  <main>
    <section class="figure" aria-labelledby="name">
      <canvas
        id="map"
        class="map"
        role="img"
        aria-label="A scatter map of about 3,000 points grouped into four clusters of skills and work: agents and LLM products, retrieval and RAG, data science and ML, and shipping to production. The same information is listed in text on this page."
      ></canvas>

      <div class="intro">
        <h1 id="name">{person.name}</h1>
        <p class="line">{person.line}</p>
        <p class="meta">{person.role} at Money Means, based in the UK and open to relocation.</p>

        <div class="actions">
          <a class="button primary" href={`mailto:${person.email}`}>Email me</a>
          <a class="button" href={person.cv} download>Download CV</a>
          <a class="button quiet" href={person.linkedin} rel="noopener">LinkedIn</a>
        </div>

        <div class="explore">
          <p class="explore-title" id="explore-title">Explore my work by area</p>
          <div class="legend" role="group" aria-labelledby="explore-title">
            {
              clusters.map((c) => (
                <button type="button" class="key" data-cluster={c.id} aria-pressed="false" style={`--c:${c.color}`}>
                  <span class="swatch" aria-hidden="true" />
                  {c.name}
                </button>
              ))
            }
          </div>

          <label class="search">
            <span class="visually-hidden">Search the map</span>
            <input id="search" type="search" placeholder="Search the map: RAG, Docker, evals…" autocomplete="off" spellcheck="false" />
          </label>

          <div class="panel" id="panel" aria-live="polite">
            <p class="panel-hint">Hover the points to read them. Pick an area to pull its points together.</p>
          </div>
        </div>
      </div>

      <p class="caption">
        <span class="mono">Figure 1.</span> My CV laid out by meaning. Labelled points are real skills and tools; the layout is hand-placed, not a trained model.
      </p>
    </section>

    <section class="about" aria-labelledby="about-title">
      <h2 id="about-title" class="visually-hidden">About</h2>
      <p class="about-text">{person.summary}</p>
    </section>

    <section class="experience" id="experience" aria-labelledby="experience-title">
      <h2 id="experience-title">Experience</h2>
      <ol class="roles">
        {
          roles.map((r) => (
            <li class="role">
              <p class="when mono">
                <time>{r.start}</time> – <time>{r.end}</time>
              </p>
              <div class="role-body">
                <h3>
                  {r.title}
                  <span class="org">
                    {r.org}
                    {r.place && `, ${r.place}`}
                  </span>
                </h3>
                <p class="context">{r.context}</p>
                <ul class="points">
                  {r.points.map((p) => (
                    <li data-cluster={p.cluster} style={`--c:${colorOf[p.cluster]}`}>
                      <span class="visually-hidden">{nameOf[p.cluster]}: </span>
                      {p.text}
                    </li>
                  ))}
                </ul>
                <p class="tech">{r.tech.join(', ')}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="education" aria-labelledby="education-title">
      <h2 id="education-title">Education</h2>
      <ul class="roles">
        {
          education.map((e) => (
            <li class="role">
              <p class="when mono">
                <time>{e.start}</time> – <time>{e.end}</time>
              </p>
              <div class="role-body">
                <h3>
                  {e.degree}
                  <span class="org">{e.org}</span>
                </h3>
                {e.note && <p class="context">{e.note}</p>}
              </div>
            </li>
          ))
        }
      </ul>
      <p class="languages">Languages: {person.languages}</p>
    </section>

    <section class="contact" aria-labelledby="contact-title">
      <h2 id="contact-title">Hiring for an AI engineer?</h2>
      <p>I’m based in the UK and open to relocation. The quickest way to reach me is email.</p>
      <p class="contact-email"><a href={`mailto:${person.email}`}>{person.email}</a></p>
      <div class="actions">
        <a class="button" href={person.cv} download>Download CV</a>
        <a class="button quiet" href={person.linkedin} rel="noopener">LinkedIn</a>
      </div>
    </section>
  </main>

  <footer class="footer">
    <p>© {new Date().getFullYear()} {person.name}</p>
  </footer>
</Base>

<script>
  import { clusters, roles, type ClusterId } from '../data/cv';
  import { createEmbeddingMap } from '../scripts/embedding-map';

  const canvas = document.getElementById('map') as HTMLCanvasElement;
  const panel = document.getElementById('panel')!;
  const search = document.getElementById('search') as HTMLInputElement;
  const keys = [...document.querySelectorAll<HTMLButtonElement>('.key')];
  const panelHint = panel.innerHTML;
  const ids = new Set(clusters.map((c) => c.id));

  const escape = (s: string) =>
    s.replace(/[&<>"']/g, (ch) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[ch]!);

  function renderPanel(id: ClusterId | null) {
    if (!id) {
      panel.innerHTML = panelHint;
      return;
    }
    const c = clusters.find((cl) => cl.id === id)!;
    const evidence = roles.flatMap((r) => r.points.filter((p) => p.cluster === id).map((p) => ({ ...p, org: r.org })));
    const shown = evidence.slice(0, 2);
    panel.innerHTML = `
      <h2 class="panel-title" style="--c:${c.color}">${escape(c.name)}</h2>
      <p class="panel-summary">${escape(c.summary)}</p>
      <ul class="panel-points">
        ${shown.map((p) => `<li><span class="panel-org">${escape(p.org)}</span> ${escape(p.text)}</li>`).join('')}
      </ul>
      ${
        evidence.length > shown.length
          ? `<a class="panel-more" href="#experience">${evidence.length - shown.length} more in Experience</a>`
          : ''
      }`;
  }

  function select(id: ClusterId | null) {
    map.select(id);
    keys.forEach((k) => k.setAttribute('aria-pressed', String(k.dataset.cluster === id)));
    renderPanel(id);
    history.replaceState(null, '', id ? `#${id}` : location.pathname);
  }

  const map = createEmbeddingMap({ canvas, clusters, onSelect: select });

  keys.forEach((k) =>
    k.addEventListener('click', () => {
      const id = k.dataset.cluster as ClusterId;
      select(k.getAttribute('aria-pressed') === 'true' ? null : id);
    }),
  );

  search.addEventListener('input', () => {
    const q = search.value.trim().toLowerCase();
    if (!q) {
      map.highlight(new Set());
      return;
    }
    const matches = new Map<ClusterId, string[]>();
    for (const c of clusters) {
      const hits = c.terms.filter((t) => t.toLowerCase().includes(q));
      if (hits.length) matches.set(c.id, hits);
    }
    map.highlight(new Set([...matches.values()].flat()));
    if (matches.size === 0) {
      panel.innerHTML = `<p class="panel-hint">No points match “${escape(search.value.trim())}”. Try agents, RAG, Docker or TensorFlow.</p>`;
      return;
    }
    const best = [...matches.entries()].sort((a, b) => b[1].length - a[1].length)[0][0];
    select(best);
  });

  document.fonts.ready.then(() => {
    const initial = location.hash.slice(1);
    if (ids.has(initial as ClusterId)) select(initial as ClusterId);
  });
</script>

<style>
  .figure {
    position: relative;
    min-height: max(100svh, 680px);
    display: grid;
    align-items: center;
    padding-inline: var(--gutter);
    padding-block: clamp(2rem, 5vh, 4rem);
    overflow: hidden;
    border-bottom: 1px solid var(--rule);
  }

  .map {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    touch-action: pan-y;
  }

  .intro {
    position: relative;
    z-index: 1;
    width: min(27rem, 31vw);
    display: grid;
    gap: 1.1rem;
  }

  h1 {
    font-size: var(--step-3);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 0.95;
    font-variation-settings: 'wdth' 85;
  }

  .line {
    font-size: clamp(1.4rem, 1.1rem + 0.8vw, 1.95rem);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.015em;
  }

  .meta {
    color: var(--ink-2);
    font-size: var(--step--1);
  }

  .explore {
    display: grid;
    gap: 0.75rem;
    margin-top: 0.75rem;
  }

  .explore-title {
    font-weight: 600;
    font-size: var(--step--1);
  }

  .legend {
    display: grid;
    gap: 0.25rem;
  }

  .key {
    --c: var(--ink);
    display: flex;
    align-items: center;
    gap: 0.65rem;
    width: 100%;
    padding: 0.5rem 0.7rem;
    border: 1px solid transparent;
    border-radius: 8px;
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-size: var(--step--1);
    font-weight: 500;
    text-align: left;
    cursor: pointer;
    transition:
      background-color 160ms ease-out,
      border-color 160ms ease-out;
  }

  .key:hover {
    background: color-mix(in srgb, var(--c) 7%, var(--ground-raised));
  }

  .key[aria-pressed='true'] {
    background: color-mix(in srgb, var(--c) 10%, var(--ground-raised));
    border-color: color-mix(in srgb, var(--c) 45%, transparent);
    font-weight: 650;
  }

  .swatch {
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    background: var(--c);
    flex: none;
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--c) 18%, transparent);
  }

  .search input {
    width: 100%;
    padding: 0.6rem 0.8rem;
    border: 1px solid var(--rule);
    border-radius: 8px;
    background: var(--ground-raised);
    color: var(--ink);
    font: inherit;
    font-size: var(--step--1);
  }

  .search input::placeholder {
    color: var(--ink-3);
  }

  .search input:focus-visible {
    outline-offset: 0;
    border-color: var(--retrieval);
  }

  .panel {
    min-height: 9.5rem;
    font-size: var(--step--1);
    color: var(--ink-2);
  }

  .panel :global(.panel-hint) {
    color: var(--ink-3);
  }

  .panel :global(.panel-title) {
    font-size: var(--step-1);
    color: var(--ink);
    margin-bottom: 0.3rem;
  }

  .panel :global(.panel-summary) {
    margin-bottom: 0.6rem;
  }

  .panel :global(.panel-points) {
    display: grid;
    gap: 0.45rem;
    margin: 0 0 0.55rem;
    padding: 0;
    list-style: none;
    color: var(--ink);
    line-height: 1.45;
  }

  .panel :global(.panel-org) {
    display: block;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--ink-3);
  }

  .panel :global(.panel-more) {
    font-weight: 600;
    color: var(--ink);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }

  .button {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0.55rem 1.05rem;
    border: 1px solid var(--ink);
    border-radius: 999px;
    background: var(--ground-raised);
    color: var(--ink);
    font-weight: 600;
    font-size: var(--step--1);
    text-decoration: none;
    transition:
      background-color 160ms ease-out,
      color 160ms ease-out,
      transform 160ms ease-out;
  }

  .button:hover {
    background: var(--ink);
    color: var(--ground-raised);
  }

  .button:active {
    transform: translateY(1px);
  }

  .button.primary {
    background: var(--ink);
    color: var(--ground-raised);
  }

  .button.primary:hover {
    background: #ffffff;
  }

  .button.quiet {
    border-color: var(--rule);
  }

  .button.quiet:hover {
    border-color: var(--ink);
  }

  .caption {
    position: absolute;
    right: var(--gutter);
    bottom: 2.2rem;
    max-width: 30rem;
    font-size: 0.8rem;
    color: var(--ink-3);
    text-align: right;
    pointer-events: none;
  }

  .about,
  .experience,
  .education,
  .contact {
    padding-inline: var(--gutter);
  }

  .about {
    padding-block: clamp(4rem, 10vw, 8rem) clamp(3rem, 7vw, 5rem);
  }

  .about-text {
    max-width: 34ch;
    font-size: var(--step-2);
    line-height: 1.3;
    font-weight: 450;
    letter-spacing: -0.012em;
    margin-left: clamp(0rem, 22vw, 22rem);
  }

  .experience,
  .education {
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
  }

  .experience h2,
  .education h2 {
    font-size: var(--step-2);
    margin-bottom: clamp(1.5rem, 4vw, 2.75rem);
  }

  .roles {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .role {
    display: grid;
    grid-template-columns: minmax(9rem, 22vw) minmax(0, 46rem);
    gap: 0.5rem 2rem;
    padding-block: 1.75rem;
    border-top: 1px solid var(--rule);
  }

  .when {
    color: var(--ink-3);
    padding-top: 0.3rem;
  }

  .role h3 {
    font-size: var(--step-1);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.2rem 0.75rem;
    margin-bottom: 0.6rem;
  }

  .org {
    font-weight: 450;
    color: var(--ink-2);
    font-size: var(--step-0);
    letter-spacing: 0;
  }

  .context {
    color: var(--ink-2);
    max-width: 68ch;
    margin-bottom: 0.9rem;
  }

  .points {
    display: grid;
    gap: 0.5rem;
    margin: 0 0 1rem;
    padding: 0;
    list-style: none;
    max-width: 68ch;
  }

  .points li {
    position: relative;
    padding-left: 1.3rem;
  }

  .points li::before {
    content: '';
    position: absolute;
    left: 0.1rem;
    top: 0.62em;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--c);
  }

  .tech {
    color: var(--ink-3);
    font-size: var(--step--1);
    max-width: 68ch;
  }

  .languages {
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
    color: var(--ink-2);
  }

  .contact {
    padding-block: clamp(5rem, 12vw, 9rem);
    display: grid;
    gap: 1rem;
    justify-items: start;
  }

  .contact h2 {
    font-size: var(--step-3);
    letter-spacing: -0.035em;
    font-variation-settings: 'wdth' 85;
    max-width: 14ch;
  }

  .contact > p {
    color: var(--ink-2);
    max-width: 52ch;
  }

  .contact-email {
    font-size: var(--step-2);
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .contact-email a {
    color: var(--ink);
    text-decoration-color: var(--agents);
    text-decoration-thickness: 2px;
  }

  .footer {
    padding: 1.5rem var(--gutter) 2rem;
    border-top: 1px solid var(--rule);
    color: var(--ink-3);
    font-size: 0.85rem;
  }

  @media (max-width: 959px) {
    .figure {
      display: flex;
      flex-direction: column;
      min-height: 0;
      padding-block: 2.5rem 0;
    }

    .intro {
      order: 1;
      width: 100%;
      max-width: 34rem;
    }

    .map {
      order: 2;
      position: relative;
      inset: auto;
      display: block;
      height: 62svh;
      min-height: 380px;
      margin-top: 1.5rem;
      margin-inline: calc(var(--gutter) * -1);
      width: calc(100% + var(--gutter) * 2);
      border-top: 1px solid var(--rule);
    }

    .caption {
      order: 3;
      position: static;
      text-align: left;
      padding-block: 0.75rem 1.5rem;
    }

    .about-text {
      margin-left: 0;
    }

    .role {
      grid-template-columns: 1fr;
    }
  }
</style>
