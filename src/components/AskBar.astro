---
// The ask bar: collapsed to a pill until opened; answers grow upwards above the input.
interface Props {
  suggestions: string[];
}
const { suggestions } = Astro.props;
---

<div class="ask" data-ask data-open="false">
  <button type="button" class="pill" data-open>
    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="2"></circle><path d="m20 20-4.2-4.2" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
    Ask about my work
  </button>

  <div class="panel" role="search" aria-label="Ask about my work">
    <div class="thread" data-thread aria-live="polite"></div>
    <div class="suggestions">
      {suggestions.map((q) => <button type="button" class="suggestion" data-question={q}>{q}</button>)}
    </div>
    <form class="row">
      <label for="question" class="visually-hidden">Ask about my work</label>
      <input id="question" name="q" type="text" maxlength="140" autocomplete="off" enterkeyhint="search" placeholder="Ask about my work…" />
      <button type="submit" class="send" aria-label="Ask" disabled>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M5 12h12M12 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
      </button>
    </form>
    <div class="foot">
      <p data-status>Answers are quoted from my CV, searched in your browser.</p>
      <button type="button" class="close" data-close>Close</button>
    </div>
  </div>
</div>

<style>
  .ask {
    position: fixed;
    left: 50%;
    bottom: clamp(1rem, 3vh, 1.75rem);
    z-index: 3;
    width: min(42rem, calc(100vw - 2rem));
    transform: translateX(-50%);
    display: grid;
    justify-items: center;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0 1.2rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: var(--ground-raised);
    color: var(--ink);
    font: inherit;
    font-weight: 600;
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.35);
    cursor: pointer;
  }

  .panel {
    display: none;
    width: 100%;
    gap: 0.6rem;
    padding: 0.9rem;
    border: 1px solid var(--rule);
    border-radius: 16px;
    background: var(--ground-raised);
    box-shadow: 0 18px 50px rgb(0 0 0 / 0.45);
  }

  .ask[data-open='true'] .pill {
    display: none;
  }

  .ask[data-open='true'] .panel {
    display: grid;
  }

  .thread {
    max-height: min(46vh, 26rem);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .thread:empty {
    display: none;
  }

  .thread :global(.answer-title) {
    font-size: var(--step-1);
    margin-bottom: 0.5rem;
  }

  .thread :global(.answer-quotes) {
    display: grid;
    gap: 0.6rem;
    margin: 0 0 0.6rem;
    padding: 0;
    list-style: none;
    line-height: 1.45;
  }

  .thread :global(.answer-source) {
    display: block;
    color: var(--ink-3);
    font-size: 0.8rem;
    font-weight: 600;
  }

  .thread :global(.answer-score) {
    margin-left: 0.5rem;
    font-family: var(--mono);
    font-weight: 400;
  }

  .thread :global(.answer-method),
  .foot p {
    color: var(--ink-3);
    font-size: 0.8rem;
  }

  .suggestions {
    display: flex;
    gap: 0.4rem;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .suggestion {
    flex: none;
    min-height: 36px;
    padding: 0 0.8rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: none;
    color: var(--ink-2);
    font: inherit;
    font-size: 0.85rem;
    cursor: pointer;
  }

  .suggestion:hover {
    color: var(--ink);
    border-color: var(--ink-3);
  }

  .row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.3rem 0.3rem 0.3rem 0.9rem;
    border: 1px solid var(--rule);
    border-radius: 12px;
    background: var(--ground);
  }

  .row:focus-within {
    border-color: var(--retrieval);
  }

  input {
    flex: 1;
    min-width: 0;
    min-height: 44px;
    border: 0;
    background: transparent;
    color: var(--ink);
    font: inherit;
    outline: none;
  }

  input::placeholder {
    color: var(--ink-3);
  }

  .send:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .send {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 10px;
    background: var(--ink);
    color: var(--ground);
    cursor: pointer;
  }

  .foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .close {
    min-height: 36px;
    border: 0;
    background: none;
    color: var(--ink-2);
    font: inherit;
    font-size: 0.85rem;
    cursor: pointer;
  }

  @media (max-width: 959px) {
    .suggestion {
      min-height: 44px;
    }
  }
</style>
