---
// One scroll step: a screen-tall band holding one card. The story controller marks
// the step in the middle of the viewport with data-active; the others recede.
interface Props {
  id: string;
  /** Where the card sits: beside the map (default) or centred, e.g. under particle text. */
  align?: 'side' | 'centre';
}
const { id, align = 'side' } = Astro.props;
---

<div class:list={['step', align]} id={id} data-step={id}>
  <slot />
</div>

<style>
  /* Each layout only sets the step's padding; the card's height cap follows from it, so a
     card never runs under the top bar or the ask button and scrolls inside itself instead. */
  .step {
    --pad-top: 5rem;
    --pad-bottom: 5rem;
    --pad-inline: var(--gutter);
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding: var(--pad-top) var(--pad-inline) var(--pad-bottom);
    pointer-events: none; /* only cards catch the pointer; the map stays hoverable */
  }

  .step > :global(*) {
    max-height: calc(100svh - var(--pad-top) - var(--pad-bottom));
    overflow-y: auto;
    overscroll-behavior: contain;
    opacity: 0.25;
    transition: opacity 400ms ease-out;
  }

  .step[data-active] > :global(*) {
    opacity: 1;
  }

  .step.centre {
    --pad-bottom: 8rem;
    justify-content: center;
    align-items: flex-end;
  }

  /* Stacked (phones held upright; same query as src/scripts/layout.ts): cards sit low so
     the map has the top of the screen, clear of the ask button below them. */
  @media (max-width: 959px) and (min-height: 501px) {
    .step {
      --pad-top: max(5rem, 40svh); /* the map always keeps the top of the screen */
      --pad-bottom: calc(var(--ask-bottom) + var(--tap) + 1.25rem);
      --pad-inline: 1rem;
      align-items: flex-end;
    }
  }

  /* Short screens (phones turned sideways): cards stay beside the map, centred. */
  @media (max-height: 500px) {
    .step,
    .step.centre {
      --pad-bottom: 4.5rem;
      align-items: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .step > :global(*) {
      transition: none;
    }
  }
</style>
