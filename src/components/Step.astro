---
// One scroll step: a screen-tall band holding one card. The story controller marks
// the step in the middle of the viewport with data-active; the others recede.
interface Props {
  id: string;
  /** Where the card sits: beside the map (default) or centred, e.g. under particle text. */
  align?: 'side' | 'centre';
}
const { id, align = 'side' } = Astro.props;
---

<div class:list={['step', align]} id={id} data-step={id}>
  <slot />
</div>

<style>
  .step {
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding: 5rem var(--gutter);
    pointer-events: none; /* only cards catch the pointer; the map stays hoverable */
  }

  .step > :global(*) {
    opacity: 0.25;
    transition: opacity 400ms ease-out;
  }

  .step[data-active] > :global(*) {
    opacity: 1;
  }

  .step.centre {
    justify-content: center;
    align-items: flex-end;
    padding-bottom: 8rem;
  }

  /* Stacked (phones held upright; same query as src/scripts/layout.ts): cards sit low so
     the map has the top of the screen, clear of the ask button below them. */
  @media (max-width: 959px) and (min-height: 501px) {
    .step {
      align-items: flex-end;
      padding: 5rem 1rem calc(var(--ask-bottom) + var(--tap) + 1.25rem);
    }
  }

  /* Short screens (phones turned sideways): cards stay beside the map and scroll inside
     themselves rather than running under the top bar or the ask button. */
  @media (max-height: 500px) {
    .step,
    .step.centre {
      align-items: center;
      padding-block: 5rem 4.5rem; /* clear of the top bar and the ask button */
    }

    .step > :global(.card) {
      max-height: calc(100svh - 9.5rem);
      overflow-y: auto;
      overscroll-behavior: contain;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .step > :global(*) {
      transition: none;
    }
  }
</style>
