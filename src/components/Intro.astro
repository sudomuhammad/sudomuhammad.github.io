---
// The first screen: the name, what I do, and how to reach me. With the intro running
// (html.intro, set in <head>), the name first appears as its WordPiece tokens, which
// burst into the map.
import { intro } from '../data/copy';
import { CV_PDF, person, roles } from '../data/cv';
import { introTokens, themes } from '../data/map';

const rows = [introTokens.name, introTokens.line];
const colorAt = (i: number) => themes[i % themes.length].color;
---

<section class="intro" id="top" data-step="top" aria-labelledby="name">
  <div class="headline">
    <h1 id="name">{person.name}</h1>
    <p class="line">{person.line}</p>
    <div class="tokens" aria-hidden="true">
      {
        rows.map((row, r) => (
          <div class="token-row">
            {row.map((piece, i) => (
              <span class="token" style={`--i:${i + r * 4};--c:${colorAt(i + r * 2)}`}>
                {piece.startsWith('##') ? (
                  <>
                    <span class="hash">##</span>
                    {piece.slice(2)}
                  </>
                ) : (
                  piece
                )}
              </span>
            ))}
          </div>
        ))
      }
    </div>
  </div>
  <div class="about">
    <p class="meta">{person.role}, {intro.recently} {roles[0].org}</p>
    <p class="meta"><strong>{person.availability}</strong> · {person.location}</p>
  </div>
  <p class="actions">
    <a class="button primary" href={`mailto:${person.email}`}>Email me</a>
    <a class="button" href={person.linkedin} rel="noopener">LinkedIn</a>
    <a class="button" href={CV_PDF} download>Download CV</a>
  </p>
  <p class="hint">{intro.hint}</p>
</section>

<style>
  .intro {
    position: relative;
    min-height: 100svh;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 1.25rem;
    padding: 6rem var(--gutter);
    text-align: center;
    pointer-events: none;
  }

  .headline {
    position: relative;
    display: grid;
    gap: 0.9rem;
    justify-items: center;
  }

  h1 {
    /* Capped by the viewport too, so the name still fits a phone with text enlarged. */
    font-size: min(clamp(3rem, 2rem + 6vw, 7.5rem), 16vw);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 0.92;
    font-variation-settings: 'wdth' 85;
  }

  .line {
    font-size: clamp(1.25rem, 1rem + 1vw, 1.9rem);
    font-weight: 500;
  }

  .about {
    display: grid;
    gap: 0.2rem;
  }

  .meta,
  .hint {
    color: var(--ink-3);
    font-size: var(--step--1);
  }

  .meta strong {
    color: var(--ink);
    font-weight: 600;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem;
    pointer-events: auto; /* the rest of the intro lets the map take the pointer */
  }

  .hint {
    position: absolute;
    bottom: 6.5rem;
  }

  /* ---------------------------------------------------------------- tokens */
  .tokens {
    display: none;
  }

  :global(html.intro) .tokens {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    gap: 0.9rem;
  }

  .token-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.45rem;
  }

  .token {
    padding: 0.3rem 0.6rem;
    border: 1px solid var(--c);
    border-radius: 6px;
    background: color-mix(in srgb, var(--c) 14%, var(--ground));
    font-family: var(--mono);
    font-size: clamp(1rem, 0.8rem + 1vw, 1.6rem);
    line-height: 1.2;
    opacity: 0;
    /* Without the intro script the tokens also leave on their own (see the fallback below). */
    animation:
      token-in 380ms cubic-bezier(0.2, 0.8, 0.2, 1) calc(var(--i) * 55ms) forwards,
      token-out 260ms ease-in 2.4s forwards;
  }

  .hash {
    color: var(--ink-3);
  }

  :global(html.intro-js) .token {
    animation: token-in 380ms cubic-bezier(0.2, 0.8, 0.2, 1) calc(var(--i) * 55ms) forwards;
  }

  :global(html.intro-done) .token {
    animation: token-out 260ms ease-in forwards;
  }

  /* The headline waits for the burst. The 2.6s reveal is a fallback for when the intro
     script never runs; once it runs (.intro-js) it decides when the headline appears. */
  :global(html.intro) .headline > h1,
  :global(html.intro) .headline > .line,
  :global(html.intro) .about,
  :global(html.intro) .actions,
  :global(html.intro) .hint {
    opacity: 0;
    animation: fade-in 500ms ease-out 2.6s forwards;
  }

  :global(html.intro-js) .headline > h1,
  :global(html.intro-js) .headline > .line,
  :global(html.intro-js) .about,
  :global(html.intro-js) .actions,
  :global(html.intro-js) .hint {
    animation: none;
  }

  :global(html.intro-done) .headline > h1,
  :global(html.intro-done) .headline > .line,
  :global(html.intro-done) .about,
  :global(html.intro-done) .actions,
  :global(html.intro-done) .hint {
    animation: fade-in 600ms ease-out 120ms forwards;
  }

  @keyframes token-in {
    from {
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes token-out {
    from {
      opacity: 1;
    }
    to {
      opacity: 0;
      transform: scale(0.85);
    }
  }

  @keyframes fade-in {
    to {
      opacity: 1;
    }
  }
</style>
