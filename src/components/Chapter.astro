---
// A chapter of the story: its steps, each rendered by the card for its kind.
import type { Chapter } from '../data/story';
import Card from './Card.astro';
import Step from './Step.astro';
import ApproachCard from './cards/ApproachCard.astro';
import ContactCard from './cards/ContactCard.astro';
import ExperienceCard from './cards/ExperienceCard.astro';
import MethodCard from './cards/MethodCard.astro';
import SectionCard from './cards/SectionCard.astro';

interface Props {
  chapter: Chapter;
}
const { chapter } = Astro.props;
const headingId = `${chapter.id}-title`;
---

<section class="chapter" aria-labelledby={headingId}>
  {
    chapter.steps.map((step) => (
      <Step id={step.id} align={step.kind === 'contact' ? 'centre' : 'side'}>
        {step.kind === 'chapter' && (
          <Card labelledby={headingId}>
            <h2 id={headingId} class="chapter-title">
              {chapter.title}
            </h2>
            <p>{chapter.lede}</p>
          </Card>
        )}
        {step.kind === 'section' && <SectionCard theme={step.theme} evidence={step.evidence} skills={step.skills} />}
        {step.kind === 'approach' && <ApproachCard headingId={headingId} title={chapter.title} principles={step.principles} />}
        {step.kind === 'experience' && (
          <ExperienceCard headingId={headingId} title={chapter.title} lede={chapter.lede} roles={step.roles} education={step.education} />
        )}
        {step.kind === 'method' && <MethodCard headingId={headingId} title={chapter.title} />}
        {step.kind === 'contact' && <ContactCard headingId={headingId} title={chapter.title} lede={chapter.lede} />}
      </Step>
    ))
  }
</section>

<style>
  .chapter-title {
    font-size: var(--step-3);
    letter-spacing: -0.035em;
    font-variation-settings: 'wdth' 85;
  }
</style>
