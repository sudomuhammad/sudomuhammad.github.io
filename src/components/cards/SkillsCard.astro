---
import Card from '../Card.astro';

interface Props {
  group: string;
  summary: string;
  items: string[];
}
const { group, summary, items } = Astro.props;
---

<Card>
  <h2>{group}</h2>
  <p>{summary}</p>
  <p class="items">{items.join(', ')}</p>
</Card>

<style>
  .items {
    color: var(--ink);
    line-height: 1.6;
  }
</style>
