---
// "How I work": pointing at a principle lights its evidence on the map.
import type { Principle } from '../../data/story';
import Card from '../Card.astro';
import Pointables from '../Pointables.astro';

interface Props {
  headingId: string;
  title: string;
  principles: Principle[];
}
const { headingId, title, principles } = Astro.props;

const items = principles.map((p) => ({
  title: p.title,
  text: p.text,
  note: `Shown in: ${p.evidence.map((e) => e.title).join(', ')}.`,
}));
---

<Card labelledby={headingId}>
  <h2 id={headingId}>{title}</h2>
  <Pointables items={items} />
</Card>
