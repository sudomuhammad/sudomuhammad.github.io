---
import { CV_PDF, person } from '../../data/cv';
import Card from '../Card.astro';

interface Props {
  headingId: string;
  title: string;
  lede: string;
}
const { headingId, title, lede } = Astro.props;
---

<Card wide labelledby={headingId}>
  <h2 id={headingId}>{title}</h2>
  <p>{lede} I’m based in the UK and open to relocation.</p>
  <p class="email"><a href={`mailto:${person.email}`}>{person.email}</a></p>
  <p class="links">
    <a class="button" href={person.linkedin} rel="noopener">LinkedIn</a>
    <a class="button" href={CV_PDF} download>Download CV</a>
  </p>
</Card>

<style>
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .email {
    font-size: var(--step-1);
    font-weight: 650;
  }

  .email a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    color: var(--ink);
    text-decoration-color: var(--accent-warm);
    text-decoration-thickness: 2px;
    overflow-wrap: anywhere; /* the address is one long word; let it break when text is enlarged */
  }

</style>
