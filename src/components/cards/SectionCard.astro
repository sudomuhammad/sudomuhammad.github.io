---
// One area of work: every CV bullet filed under it, and the skills that go with it.
import { orgOf, type MappedPassage, type Theme } from '../../data/map';
import Card from '../Card.astro';

interface Props {
  theme: Theme;
  evidence: MappedPassage[];
  skills: string[];
}
const { theme, evidence, skills } = Astro.props;
const headingId = `work-${theme.key}-title`;
---

<Card labelledby={headingId}>
  <h2 id={headingId}>
    <span class="swatch" style={`--c:${theme.color}`} aria-hidden="true"></span>{theme.name}
  </h2>
  <p>{theme.summary}</p>
  <ul class="evidence">
    {
      evidence.map((p) => (
        <li>
          <span class="meta">
            {p.title}
            {p.source !== p.title && ` · ${orgOf(p.source)}`}
          </span>
          <span class="text">{p.text}</span>
        </li>
      ))
    }
  </ul>
  {skills.length > 0 && <p class="skills">{skills.join(', ')}</p>}
</Card>

<style>
  /* The section's colour on the map, as on the map's own points. */
  .swatch {
    display: inline-block;
    width: 0.55em;
    height: 0.55em;
    margin-right: 0.4em;
    border-radius: 50%;
    background: var(--c);
    vertical-align: 0.12em;
  }

  .evidence li {
    color: var(--ink);
    line-height: 1.45;
  }

  .skills {
    font-size: var(--step--1);
    color: var(--ink-3);
  }

  /* Stacked (same query as src/scripts/layout.ts): titles only, so the map stays visible
     above the card. Full text is a tap away on the map. */
  @media (max-width: 959px) and (min-height: 501px) {
    .text,
    .skills {
      display: none;
    }

    .evidence .meta {
      color: var(--ink);
      font-size: var(--step--1);
    }
  }
</style>
